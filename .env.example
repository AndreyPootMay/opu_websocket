# Port the HTTP + Socket.IO server listens on.
PORT=4000

# Comma-separated list of origins allowed to open a Socket.IO connection.
# Use '*' to allow any origin (fine for the Capacitor APK which sends
# Origin: capacitor://localhost or http://localhost). In production lock this
# down to your real frontends.
CORS_ORIGINS=*

# Set to "1" to dump every webhook payload + every emitted event to stdout.
DEBUG_EVENTS=1
